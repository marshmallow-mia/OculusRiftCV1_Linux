+			"\"fisheye\":%d,\"K\":[%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g,%.9g],"
+			"\"dist\":[%.9g,%.9g,%.9g,%.9g,%.9g]}\n",
