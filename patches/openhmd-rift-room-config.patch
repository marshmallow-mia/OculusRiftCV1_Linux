+		if (!r->settled && ++r->quiet_rounds >= EXTRINSIC_SETTLE_QUIET_ROUNDS) {
+			r->settled = true;
+			LOGI("sensor %s calibration SETTLED", rift_sensor_serial_no(sensor));
