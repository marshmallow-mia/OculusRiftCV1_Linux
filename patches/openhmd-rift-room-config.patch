+		ohmd_lock_mutex(ctx->refine_lock);
+		r->quiet_rounds = 0;
+		if (r->settled) {
+			r->settled = false;
+			LOGI("sensor %s calibration UNSETTLED", rift_sensor_serial_no(sensor));
